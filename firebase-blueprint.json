{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user stats, streaks, and progress.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "xp": { "type": "integer", "description": "Total experience points" },
        "level": { "type": "integer", "description": "Calculated level: floor(xp/100) + 1" },
        "streak": { "type": "integer", "description": "Current daily streak count" },
        "maxStreak": { "type": "integer" },
        "freezeUntil": { "type": "string", "format": "date-time", "description": "Streak is protected until this time" },
        "lastActive": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "xp", "level", "streak"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Defines a habit to track.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title"]
    },
    "Completion": {
      "title": "Habit Completion",
      "description": "Records a single completion of a habit.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "habitId": { "type": "string" },
        "date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "habitId", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/habits/{habitId}": {
      "schema": "Habit",
      "description": "User habits"
    },
    "/completions/{completionId}": {
      "schema": "Completion",
      "description": "Habit completions"
    }
  }
}
