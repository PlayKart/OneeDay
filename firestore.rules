rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Profile Validation
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && data.xp is int && data.xp >= 0
        && data.level is int && data.level >= 1
        && data.streak is int && data.streak >= 0
        && (data.freezeUntil == null || data.freezeUntil is timestamp)
        && (data.get('why_oneday', null) == null || (data.why_oneday is string && data.why_oneday.size() <= 500 && data.why_oneday.matches('(?s)^.*(?:\\S.*){5,}$')))
        && data.updatedAt == request.time;
    }

    // Habit Validation
    function isValidHabit(data) {
      return data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && (data.description == null || (data.description is string && data.description.size() <= 500))
        && data.createdAt == request.time;
    }

    // Completion Validation
    function isValidCompletion(data) {
      return data.userId == request.auth.uid
        && isValidId(data.habitId)
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.timestamp == request.time;
    }

    // --- Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Profiles are private
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Generic update (XP, streak, etc. - usually driven by backend logic but for now allowing client updates if valid)
        // In a strict mode, we might restrict XP/streak to backend only, but this is a standard full-stack demo.
        true
      );
    }

    match /habits/{habitId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidHabit(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidHabit(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /completions/{completionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCompletion(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
